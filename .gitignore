# Dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js and build output
.next/
out/
build/
coverage/

# Local environment and secrets
# Every .env* file is ignored, including .env.example and .env.local.
# Never re-include an env template here: if it ever holds a live key it will
# be committed and GitHub push protection will block the push.
.env*
*.pem

# Scratch/design-reference images (not part of the shipped app)
img/
screenshot/
screenshots/

# TypeScript and logs
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local tooling and OS files
.vercel/
.vscode/
.DS_Store
Thumbs.db
